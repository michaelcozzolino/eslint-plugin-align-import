{
    "name": "eslint-plugin-align-import",
    "version": "1.0.0",
    "description": "Babel plugin to align your import statements.",
    "license": "MIT",
    "author": "Simon Reinisch <trash@reinisch.io>",
    "main": "./lib/index.js",
    "keywords": [
        "eslint",
        "eslintplugin",
        "eslint-plugin"
    ],
    "scripts": {
